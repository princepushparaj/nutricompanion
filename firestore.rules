rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Validation Helpers ---
    function isValidUserProfile(data) {
      return data.uid == request.auth.uid 
        && data.email is string && data.email.size() <= 128
        && (data.get('displayName', null) == null || (data.displayName is string && data.displayName.size() <= 256))
        && (data.get('doctorEmail', null) == null || (data.doctorEmail is string && data.doctorEmail.size() <= 128))
        && (data.get('progressData', null) == null || data.progressData is list)
        && data.keys().hasAll(['uid', 'email']) && data.keys().size() <= 10;
    }

    function isValidDietPlan(data) {
      return data.userId == request.auth.uid
        && data.name is string && data.name.size() <= 200
        && data.active is bool
        && data.keys().hasAll(['userId', 'name', 'active']) && data.keys().size() <= 8;
    }

    function isValidDietItem(data) {
      return data.planId is string && data.planId.size() <= 128
        && data.time is string && data.time.size() <= 20
        && data.mealType is string && data.mealType.size() <= 100
        && data.description is string && data.description.size() <= 2000
        && (data.get('prepTimeMinutes', null) == null || data.prepTimeMinutes is number)
        && (data.get('calories', null) == null || data.calories is number)
        && (data.get('protein', null) == null || data.protein is number)
        && (data.get('carbs', null) == null || data.carbs is number)
        && (data.get('fats', null) == null || data.fats is number)
        && data.keys().hasAll(['planId', 'time', 'mealType', 'description']) && data.keys().size() <= 15;
    }

    function isValidDailyLog(data) {
      return data.userId == request.auth.uid
        && data.date is string && data.date.size() <= 20
        && data.waterIntakeMl is number
        && data.waterGoalMl is number
        && (data.get('weightKg', null) == null || data.weightKg is number)
        && (data.get('mealsLogged', null) == null || data.mealsLogged is map)
        && data.keys().hasAll(['userId', 'date', 'waterIntakeMl', 'waterGoalMl']) && data.keys().size() <= 12;
    }

    // --- Paths ---

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming())
        && incoming().uid == existing().uid; // Immutable UID

      match /dietPlans/{planId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidDietPlan(incoming());
        allow update: if isOwner(userId) && isValidDietPlan(incoming());
        allow delete: if isOwner(userId);

        match /items/{itemId} {
          allow list, get: if isOwner(userId);
          allow create: if isOwner(userId) && isValidDietItem(incoming());
          allow update: if isOwner(userId) && isValidDietItem(incoming());
          allow delete: if isOwner(userId);
        }
      }

      match /logs/{logId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidDailyLog(incoming());
        allow update: if isOwner(userId) && isValidDailyLog(incoming());
        allow delete: if isOwner(userId);
      }
    }
  }
}
